<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>Trace.Pay</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>4.4.0</string>
  <key>CFBundleVersion</key><string>23</string>
  <key>LSRequiresIPhoneOS</key><true/>
  <key>NSFaceIDUsageDescription</key><string>Trace.Pay uses Face ID to unlock the account already enrolled on this device.</string>
  <key>NSCameraUsageDescription</key><string>Trace.Pay uses the camera when you choose to capture a profile photo or scan a payment QR.</string>
  <key>NSContactsUsageDescription</key><string>Trace.Pay accesses your contacts only when you choose a contact to begin a payment. Your contacts are not uploaded by the contacts picker.</string>
  <key>NSLocalNetworkUsageDescription</key><string>Trace.Pay connects to your development Mac on the local network when testing the backend on your own Wi-Fi.</string>
  <key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
  <key>LSApplicationQueriesSchemes</key><array><string>tez</string><string>phonepe</string><string>paytmmp</string><string>bhim</string><string>upi</string><string>supermoney</string></array>
  <key>TRACEPAY_API_BASE_URL</key><string>$(TRACEPAY_API_BASE_URL)</string>
  <key>UILaunchScreen</key><dict/>
  <key>UIApplicationSceneManifest</key><dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
  <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
</dict>
</plist>
