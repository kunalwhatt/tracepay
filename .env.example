# Copy to .env and replace every secret before running.
POSTGRES_DB=tracepay
POSTGRES_USER=tracepay
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Optional dedicated secret for encrypting participant profile fields. Keep stable after first use.
PII_ENCRYPTION_KEY=
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_12_CHARS_MINIMUM
UPLOAD_MAX_MB=100
INGESTION_DEFAULT_TIMEZONE=Asia/Kolkata
VITE_API_BASE_URL=http://localhost:8000


# Gemini-assisted schema mapping / repair suggestions (server-side only)
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# Optional Azure Event Hubs real-time pipeline
EVENT_HUB_CONNECTION_STRING=
EVENT_HUB_NAME=
EVENT_HUB_CONSUMER_GROUP=$Default

# Optional Azure Blob raw-dataset archival
AZURE_STORAGE_ACCOUNT_URL=
AZURE_INGESTION_CONTAINER=tracepay-ingestion
